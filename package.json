{
  "name": "itsbio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "production:audit": "node scripts/production-audit.mjs",
    "production:audit:strict": "node scripts/production-audit.mjs --strict",
    "catalog:audit": "node scripts/catalog-audit.mjs --brand=all",
    "catalog:audit:strict": "node scripts/catalog-audit.mjs --brand=all --strict",
    "product:audit": "node scripts/product-quality-audit.mjs --brand=all",
    "product:audit:strict": "node scripts/product-quality-audit.mjs --brand=all --strict",
    "product:content:audit": "node scripts/product-content-policy-audit.mjs",
    "kent:product:audit": "node scripts/product-quality-audit.mjs --brand=kent",
    "kent:content:audit": "node scripts/kent-content-fidelity-audit.mjs",
    "kent:exact:verify": "node scripts/kent-exact-content-verify.mjs",
    "kent:exact:verify:strict": "node scripts/kent-exact-content-verify.mjs --strict",
    "kent:official:verify": "node scripts/kent-exact-content-verify.mjs",
    "kent:official:verify:refresh": "node -e \"console.error('Disabled: Kent live refresh is not an approved verification path. Use npm run kent:exact:verify.'); process.exit(1)\"",
    "kent:official:verify:offline": "node scripts/kent-exact-content-verify.mjs",
    "kent:baseline:export": "node scripts/kent-product-baseline-export.mjs",
    "kent:gallery:stage": "node scripts/kent-official-gallery-stage.mjs",
    "kent:gallery:promote": "node scripts/kent-official-gallery-promote.mjs",
    "abm:product:audit": "node scripts/product-quality-audit.mjs --brand=abm",
    "abm:rebuild:parser:qa": "node scripts/abm-rebuild-parser-qa.mjs",
    "abm:rebuild:details:stage:dry": "node scripts/stage-abm-rebuild-details.mjs --dry",
    "abm:staged-links:audit": "node scripts/audit-abm-staged-links.mjs",
    "kent:product:census": "node scripts/kent-product-census-v2.mjs",
    "kent:product:census:refresh": "node -e \"console.error('Disabled: Kent live refresh is blocked by security checks and is not an approved source.'); process.exit(1)\"",
    "kent:product:census:fast": "node scripts/kent-product-census-v2.mjs --skip-product-pages",
    "kent:shop:collect": "node scripts/kent-shop-collect.mjs",
    "kent:shop:profiles": "node scripts/kent-product-from-listing.mjs --listing .cache/kent-shop-all.json --out .cache/kent-shop-profiles.json --cacheDir .cache/kent-shop-pages",
    "kent:shop:dry": "node scripts/kent-product-migrate.mjs --input .cache/kent-shop-profiles.json",
    "kent:shop:apply": "node scripts/kent-product-migrate.mjs --input .cache/kent-shop-profiles.json --apply --deactivate-missing",
    "kent:shop:preview:apply": "node scripts/kent-product-migrate.mjs --input .cache/kent-shop-profiles.json --apply --preview --deactivate-missing",
    "kent:shop:sync:dry": "npm run kent:shop:collect && npm run kent:shop:profiles && npm run kent:shop:dry",
    "kent:shop:sync:apply": "npm run kent:shop:collect && npm run kent:shop:profiles && npm run kent:shop:apply",
    "kent:product:census:write": "node -e \"console.error('Disabled: a reviewed exact-content migration plan is required.'); process.exit(1)\"",
    "kent:inventory:browser:setup": "node -e \"console.error('Disabled: browser automation is not an approved Kent workflow.'); process.exit(1)\"",
    "kent:inventory:browser": "node -e \"console.error('Disabled: browser automation is not an approved Kent workflow.'); process.exit(1)\"",
    "kent:inventory:browser:fresh": "node -e \"console.error('Disabled: browser automation is not an approved Kent workflow.'); process.exit(1)\"",
    "kent:audit": "node scripts/catalog-audit.mjs --brand=kent",
    "abm:audit": "node scripts/catalog-audit.mjs --brand=abm --skip-source",
    "kent:preflight": "node scripts/kent-preflight.mjs",
    "kent:category:dry": "node scripts/kent-category-migrate.mjs --dryRun",
    "kent:category:refresh:dry": "node scripts/kent-category-migrate.mjs --dryRun --refresh",
    "kent:category:write": "node scripts/kent-category-migrate.mjs",
    "kent:category:refresh:write": "node scripts/kent-category-migrate.mjs --refresh"
  },
  "dependencies": {
    "@portabletext/react": "^6.0.2",
    "@sanity/image-url": "^2.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "jsdom": "^28.0.0",
    "next": "^16.1.7",
    "next-sanity": "^12.0.16",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.8.0",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@sanity/vision": "^5.7.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.31",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
